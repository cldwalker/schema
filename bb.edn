{:paths ["src" "resources"]
 :min-bb-version "1.13.219"
 :deps {io.github.borkdude/quickblog
        #_"You use the newest SHA here:"
        {:git/sha "c1d82ce37ae05347fbeae13d330455db275327d5"}}
 :tasks
 {quickblog
  {:doc "Start blogging quickly! Run `bb quickblog help` for details."
   :requires ([cldwalker.schema.publish :as publish])
   :task (publish/quickblog-cli *command-line-args*)}

  schema:create
  {:doc "Create a post for each class and property in tagaholic-me-index.edn, or only the given ones, and a classes post"
   :exec-fn cldwalker.schema.publish/create
   :cli cldwalker.schema.publish/task-cli}

  schema:rebuild
  {:doc "Clean the site, recreate posts for all or the given classes and properties and render the site"
   :exec-fn cldwalker.schema.publish/rebuild
   :cli cldwalker.schema.publish/task-cli}

  ;; From https://blog.michielborkent.nl/babashka-test-runner.html
  clj:test
  {:extra-paths ["test"]
   :extra-deps {io.github.cognitect-labs/test-runner
                {:git/tag "v0.5.1" :git/sha "dfb30dd"}
                org.clojure/tools.namespace {:mvn/version "1.5.1"}}
   :doc "Run tests with cognitect test runner"
   :exec-fn cognitect.test-runner.api/test
   :cli {:spec {:dirs {:desc "Directories containing tests" :coerce [] :default ["test"]}
                :nses {:desc "Namespace symbols to test" :coerce [:symbol] :alias :n}
                :patterns {:desc "Regex strings to match namespaces" :coerce [] :alias :p}
                :vars {:desc "Fully qualified symbols of test vars to run" :coerce [:symbol]}
                :includes {:desc "Test metadata keywords to include" :coerce [:keyword] :alias :i}
                :excludes {:desc "Test metadata keywords to exclude" :coerce [:keyword] :alias :e}}}}}}
